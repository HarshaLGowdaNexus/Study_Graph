# ==============================================================================
# StudyGraph Environment Variables Template (.env.example)
#
# IMPORTANT:
# 1. Duplicate this file and name the copy '.env' in this root directory.
# 2. Fill in your real credentials in '.env'.
# 3. NEVER commit your real '.env' file to Git! (It is ignored by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration (Decision D05)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database -> Connection string:
# Direct connection (port 5432) or Session pooler (port 5432) / Transaction pooler (port 6543):
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/postgres

# ------------------------------------------------------------------------------
# 2. Supabase API & Storage Configuration (Decisions D06, D13)
# ------------------------------------------------------------------------------
# Found in Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Google Gemini API Configuration (Decisions D08, D09, D10)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True

